<Window x:Class="ImageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Viewer" Width="1000" Height="700" MinWidth="320" MinHeight="240"
        WindowStyle="None" ResizeMode="CanResize" Background="#FF141414"
        AllowDrop="True" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseMove="Window_PreviewMouseMove"
        MouseLeave="Window_MouseLeave" Drop="Window_Drop" StateChanged="Window_StateChanged"
        DpiChanged="Window_DpiChanged" Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Opened by right-clicking the image or the "more" toolbar button -->
        <ContextMenu x:Key="MainMenu" Opened="MainMenu_Opened">
            <MenuItem Header="Rotate clockwise" InputGestureText="R" Click="RotateButton_Click"/>
            <MenuItem Header="Rotate counter-clockwise" InputGestureText="Shift+R" Click="RotateCcw_Click"/>
            <MenuItem Header="Crop…" InputGestureText="C" Click="CropButton_Click"/>
            <MenuItem Tag="undo" Header="Undo crop" InputGestureText="Ctrl+Z" Click="UndoCrop_Click"/>
            <Separator/>
            <MenuItem Header="Favourites" SubmenuOpened="FavouritesMenu_SubmenuOpened">
                <MenuItem Tag="toggle" Header="Favourite" InputGestureText="F" IsCheckable="False" Click="FavouriteMenu_Click"/>
                <MenuItem Tag="only" Header="Show favourites only" InputGestureText="Shift+F" Click="FavouritesOnlyMenu_Click"/>
                <Separator/>
                <MenuItem Header="Copy favourites to…" Click="CopyFavourites_Click"/>
                <MenuItem Header="Move favourites to…" Click="MoveFavourites_Click"/>
                <MenuItem Header="Copy to “Favourites” subfolder" Click="CopyFavouritesToSubfolder_Click"/>
                <MenuItem Header="Move to “Favourites” subfolder" Click="MoveFavouritesToSubfolder_Click"/>
                <Separator/>
                <MenuItem Header="Clear favourites in this folder…" Click="ClearFavourites_Click"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="Copy_Click"/>
            <MenuItem Header="Show in Explorer" InputGestureText="Ctrl+E" Click="ShowInExplorer_Click"/>
            <MenuItem Header="Delete" InputGestureText="Del" Click="Delete_Click"/>
            <Separator/>
            <MenuItem Header="Open…" InputGestureText="Ctrl+O" Click="OpenButton_Click"/>
            <MenuItem Tag="register" Header="Set as default image viewer…" Click="RegisterDefault_Click"/>
            <MenuItem Tag="unregister" Header="Remove from Windows image apps…" Click="UnregisterDefault_Click"/>
            <MenuItem Header="Keyboard shortcuts" InputGestureText="F1" Click="Help_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Image area: scroll to zoom, drag to pan (or move the window when the image fits) -->
        <Grid x:Name="Viewport" ClipToBounds="True" Background="Transparent" ContextMenu="{StaticResource MainMenu}"
              MouseLeftButtonDown="Viewport_MouseLeftButtonDown" MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
              MouseMove="Viewport_MouseMove" MouseWheel="Viewport_MouseWheel" SizeChanged="Viewport_SizeChanged"
              MouseDown="Viewport_MouseDown" MouseUp="Viewport_MouseUp" ContextMenuOpening="Viewport_ContextMenuOpening">
            <!-- A Canvas never clips its children to the layout size, so the full image survives being scaled down;
                 the viewport's ClipToBounds does the clipping instead. -->
            <Canvas>
                <Image x:Name="ImageView" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <MatrixTransform x:Name="ImageTransform"/>
                    </Image.RenderTransform>
                </Image>
            </Canvas>

            <!-- Crop overlay: dimmed surroundings, the crop box, rule-of-thirds lines and resize handles.
                 Positioned in code; mouse input is handled by the viewport. -->
            <Canvas x:Name="CropLayer" Visibility="Collapsed" IsHitTestVisible="False">
                <Path x:Name="CropShade" Fill="#A0000000"/>
                <Path x:Name="CropGridLines" Stroke="#90FFFFFF" StrokeThickness="1"/>
                <Rectangle x:Name="CropBorder" Stroke="White" StrokeThickness="1.5"/>
                <Path x:Name="CropHandles" Fill="White" Stroke="#80000000" StrokeThickness="1"/>
            </Canvas>
            <TextBlock x:Name="MessageText" Foreground="#999" FontSize="15" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"
                       Text="Drop an image here, or press Ctrl+O"/>
        </Grid>

        <!-- Previous / next buttons, shown when hovering near the side edges -->
        <Button x:Name="PrevButton" Style="{StaticResource NavButton}" HorizontalAlignment="Left"
                Opacity="0" Content="&#xE76B;" ToolTip="Previous (←)" Click="PrevButton_Click"/>
        <Button x:Name="NextButton" Style="{StaticResource NavButton}" HorizontalAlignment="Right"
                Opacity="0" Content="&#xE76C;" ToolTip="Next (→)" Click="NextButton_Click"/>

        <!-- Crop controls, shown in crop mode -->
        <Border x:Name="CropBar" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="12,0,12,18" Padding="8,6" CornerRadius="8" Background="#F01C1C1C" SizeChanged="CropBar_SizeChanged">
            <WrapPanel Orientation="Horizontal">
                <StackPanel x:Name="RatioPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                <StackPanel x:Name="CustomRatioPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"
                            Visibility="Collapsed">
                    <TextBox x:Name="CustomRatioW" Style="{StaticResource RatioBox}" TextChanged="CustomRatio_TextChanged"/>
                    <TextBlock Text=":" Foreground="#CCC" Margin="4,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="CustomRatioH" Style="{StaticResource RatioBox}" TextChanged="CustomRatio_TextChanged"/>
                </StackPanel>
                <Border Width="1" Background="#40FFFFFF" Margin="6,4"/>
                <Button Style="{StaticResource BarIconButton}" Content="&#xE8AB;" ToolTip="Swap landscape / portrait (X)"
                        Click="CropSwap_Click"/>
                <ToggleButton x:Name="CropGridToggle" Style="{StaticResource BarIconToggle}" ToolTip="Rule-of-thirds grid (G)"
                              Click="CropGridToggle_Click">
                    <Path Data="M0.5,0.5 H14.5 V14.5 H0.5 Z M5.5,0.5 V14.5 M9.5,0.5 V14.5 M0.5,5.5 H14.5 M0.5,9.5 H14.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1"/>
                </ToggleButton>
                <TextBlock x:Name="CropSizeText" Foreground="#CCC" FontSize="12" VerticalAlignment="Center"
                           Margin="8,0" MinWidth="86" TextAlignment="Center"/>
                <Border Width="1" Background="#40FFFFFF" Margin="6,4"/>
                <Button Style="{StaticResource BarButton}" Content="Cancel" ToolTip="Esc" Click="CropCancel_Click"/>
                <Button x:Name="CropSaveCopyButton" Style="{StaticResource BarButton}" Content="Save copy"
                        ToolTip="Save the crop as a new file and keep the original" Click="CropSaveCopy_Click"/>
                <Button x:Name="CropApplyButton" Style="{StaticResource AccentButton}" Content="Apply"
                        ToolTip="Crop and overwrite the file (Enter) — Ctrl+Z undoes it" Click="CropApply_Click"/>
            </WrapPanel>
        </Border>

        <!-- Shown briefly (and with the toolbar) when the current image is a favourite -->
        <TextBlock x:Name="FavouriteBadge" FontFamily="{StaticResource IconFont}" Text="&#xEB52;" FontSize="22"
                   Foreground="#FF4D6D" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,18"
                   Opacity="0" IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Short-lived notice, e.g. why a rotation was refused -->
        <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,28"
                Padding="14,10" CornerRadius="6" Background="#EE202020" MaxWidth="560"
                Opacity="0" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" Foreground="#FFC83D"
                           FontSize="16" Margin="0,1,10,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="ToastText" Foreground="White" FontSize="13" TextWrapping="Wrap" MaxWidth="500"/>
            </StackPanel>
        </Border>

        <!-- Keyboard shortcut reference (F1); any click or key closes it -->
        <Border x:Name="HelpPanel" Visibility="Collapsed" Background="#B0000000" MouseDown="HelpPanel_MouseDown">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F0202020"
                    CornerRadius="8" Padding="28,22">
                <StackPanel>
                    <TextBlock Text="Keyboard shortcuts" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <Grid x:Name="HelpGrid"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Toolbar, shown when hovering near the top edge -->
        <Border x:Name="Toolbar" VerticalAlignment="Top" Height="40" Background="#D0101010" Opacity="0"
                MouseLeftButtonDown="Toolbar_MouseLeftButtonDown" MouseMove="Toolbar_MouseMove"
                MouseLeftButtonUp="Toolbar_MouseLeftButtonUp">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="FavouriteButton" Style="{StaticResource ToolButton}" Content="&#xEB51;" ToolTip="Add to favourites (F)" Click="FavouriteButton_Click"/>
                    <Button x:Name="CropButton" Style="{StaticResource ToolButton}" Content="&#xE7A8;" ToolTip="Crop (C)" Click="CropButton_Click"/>
                    <Button Style="{StaticResource ToolButton}" Content="&#xE7AD;" ToolTip="Rotate clockwise (R)" Click="RotateButton_Click"/>
                    <Button Style="{StaticResource ToolButton}" Content="&#xE712;" ToolTip="More" Click="MoreButton_Click"/>
                    <Button Style="{StaticResource ToolButton}" Content="&#xE740;" ToolTip="Fullscreen (F11)" Click="FullscreenButton_Click"/>
                    <Button Style="{StaticResource ToolButton}" Content="&#xE921;" ToolTip="Minimize" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource ToolButton}" Content="&#xE922;" ToolTip="Maximize" Click="MaximizeButton_Click"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close (Esc)" Click="CloseButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="FileNameText" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="InfoText" Foreground="#AAA" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
